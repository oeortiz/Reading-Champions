# Copia este archivo a .env y cambia los secretos antes de desplegar.

# Postgres (lo usan el contenedor db y la URL de conexion)
POSTGRES_USER=reading
POSTGRES_PASSWORD=reading
POSTGRES_DB=reading_champions

# URL vista desde los contenedores (el host "db" es el servicio de compose)
DATABASE_URL=postgres://reading:reading@db:5432/reading_champions

# Secreto para firmar las cookies de sesion (usa una cadena larga y aleatoria)
SESSION_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

# Administrador inicial que crea el seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Puerto publicado por el contenedor de produccion
APP_PORT=3000

# Pon true cuando la app se sirva por HTTPS (las cookies solo viajaran cifradas)
COOKIE_SECURE=false
